#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

#define button 5 

RF24 radio(9, 10); 

const byte address[6] = "00002"; 
boolean switchstate = 0;

void setup() {
    Serial.begin(115200);
    Serial.println("\nTX Circuit - ESP32-S3");
    
    pinMode(button, INPUT_PULLUP);
    
    SPI.begin(10, 11, 12, 13); 

    if (!radio.begin()) {
        Serial.println("Error: No se detecta la antena");
        while (1);
    }

    radio.openWritingPipe(address);
    radio.setPALevel(RF24_PA_HIGH);

    radio.stopListening();
    }

void loop() {

    int val = digitalRead(button);
    
    if (val == LOW) {
        switchstate = HIGH;
    } else {
        switchstate = LOW;
    }

    radio.write(&switchstate, sizeof(switchstate));
    
    Serial.print("Estado enviado: ");
    Serial.println(switchstate == HIGH ? "HIGH Signal" : "LOW Signal");
    
}
